foreach ($config in 'RequestedConfig', 'ActualConfig') {
    Write-Host "`n=== $config ==="

    $items = @(
        Get-CimInstance `
            -Namespace "root\ccm\Policy\Machine\$config" `
            -ClassName CCM_SoftwareUpdatesClientConfig `
            -ErrorAction Stop
    )

    Write-Host "Instances: $($items.Count)"
    $items | Select-Object ComponentName, Enabled
}
