$site = Invoke-CimMethod `
    -Namespace root\ccm `
    -ClassName SMS_Client `
    -MethodName GetAssignedSite `
    -ErrorAction Stop

# If CIM omitted the return status, try the Windows PowerShell WMI interface.
if ($null -eq $site.ReturnValue) {
    $site = Invoke-WmiMethod `
        -Namespace root\ccm `
        -Class SMS_Client `
        -Name GetAssignedSite `
        -ErrorAction Stop
}

if ($null -eq $site.ReturnValue) {
    throw "GetAssignedSite returned no status. Response: $($site | ConvertTo-Json -Compress)"
}

if ([uint32]$site.ReturnValue -ne 0) {
    throw "GetAssignedSite failed: ReturnValue=$($site.ReturnValue); Site='$($site.sSiteCode)'"
}

$actualSite = ([string]$site.sSiteCode).Trim()
$ExpectedSite = $ExpectedSite.Trim()

if ($actualSite -ine $ExpectedSite) {
    throw "Site mismatch: actual='$actualSite'; expected='$ExpectedSite'"
}
