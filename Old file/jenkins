---
- name: Require normal run and authorization for October reboots
  ansible.builtin.assert:
    that:
      - not ansible_check_mode
      - sccm_allow_reboot | default(false) | bool
    fail_msg: October baseline installation requires a normal run and sccm_allow_reboot=true.

- name: Create Scripts directory
  ansible.windows.win_file:
    path: 'C:\Scripts'
    state: directory

- name: Synchronize the current October main script on every run
  ansible.windows.win_copy:
    src: October2022.ps1
    dest: 'C:\Scripts\October2022.ps1'

- name: Get the applicable October package plan from the main script
  ansible.windows.win_powershell:
    script: |
      $ErrorActionPreference = 'Stop'
      $Ansible.Result = (& 'C:\Scripts\October2022.ps1' -Action Plan | ConvertFrom-Json)
      $Ansible.Changed = $false
  register: october_plan

- name: Check servicing reboot before October patching
  ansible.windows.win_powershell:
    script: |
      $ErrorActionPreference = 'Stop'
      $Ansible.Result = (& 'C:\Scripts\October2022.ps1' -Action Pending | ConvertFrom-Json)
      $Ansible.Changed = $false
  register: october_pending

- name: Clear pending reboot before October patching
  ansible.windows.win_reboot:
    reboot_timeout: 7200
    connect_timeout: 60
    post_reboot_delay: 120
  when: october_pending.result.reboot_required | bool

- name: Process each October package with a reboot boundary
  ansible.builtin.include_tasks: october_patch_one.yml
  loop: "{{ october_plan.result.packages }}"
  loop_control:
    loop_var: october_source
    label: "{{ october_source | basename }}"

- name: Record successful October baseline gate
  ansible.builtin.set_fact:
    october_baseline_verified: true

- name: Confirm October baseline before SCCM starts
  ansible.builtin.debug:
    msg: 'Selected October packages verified. Continuing to latest assigned SCCM updates.'
