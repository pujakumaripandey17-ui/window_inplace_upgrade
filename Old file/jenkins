
---
- name: Validate Windows upgrade monitoring
  hosts: windows
  gather_facts: false

  vars:
    # Use your actual upgrade staging directory
    upgrade_staging_directory: 'C:\WindowsUpgrade'

  tasks:

    - name: Initialize monitoring variables
      ansible.builtin.set_fact:
        upgrade_complete: false
        upgrade_failed: false
        upgrade_reason: "Waiting for Windows Server 2022"
        monitor_attempt: 0
        monitor_max_attempts: 3

    - name: Execute monitor_upgrade.yml
      ansible.builtin.include_tasks:
        file: roles/s_upgrade_execute/tasks/monitor_upgrade.yml

    - name: Confirm monitoring stopped successfully
      ansible.builtin.assert:
        that:
          - upgrade_complete | bool
          - not (upgrade_failed | bool)
          - monitor_attempt | int == 1
        fail_msg: "Monitoring did not stop after detecting Server 2022"
        success_msg: "Monitoring stopped successfully after one attempt"

    - name: Reset WinRM connection
      ansible.builtin.meta: reset_connection

    - name: Confirm WinRM connectivity
      ansible.builtin.wait_for_connection:
        timeout: 120
        sleep: 10

    - name: Validate OS and PowerShell execution
      ansible.windows.win_powershell:
        error_action: stop
        script: |
          $Ansible.Changed = $false
          $os = Get-CimInstance Win32_OperatingSystem

          $Ansible.Result = @{
            build = [string]$os.BuildNumber
            hostname = $env:COMPUTERNAME
            winrm_ready = $true
          }
      register: validation
      changed_when: false

    - name: Confirm Windows Server 2022
      ansible.builtin.assert:
        that:
          - validation.result.build == '20348'
          - validation.result.winrm_ready | bool

    - name: Verify next task executes
      ansible.builtin.debug:
        msg:
          - "SUCCESS: Monitor stopped"
          - "Monitoring attempts: {{ monitor_attempt }}"
          - "OS Build: {{ validation.result.build }}"
          - "WinRM connection: Ready"
          - "Next task executed successfully"
