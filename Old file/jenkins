# 1. Check what WUA / WSUS actually thinks the status of KB5131090 is in UpdatesStore
Get-CimInstance -Namespace root\ccm\SoftwareUpdates\UpdatesStore -ClassName CCM_UpdateStatus |
  Where-Object { $_.Article -eq '5131090' -or $_.UniqueId -match '43ad9cad-0c25-4d8b-ab46-5c4d802fe581' } |
  Select-Object Article, Title, Status, ScanTime

# 2. Check the last 25 lines of WUAHandler.log and ScanAgent.log to see if the scan actually talked to WSUS or errored
Get-Content 'C:\Windows\CCM\Logs\WUAHandler.log' -Tail 25
Get-Content 'C:\Windows\CCM\Logs\ScanAgent.log' -Tail 25
