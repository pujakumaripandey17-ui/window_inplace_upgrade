- name: Remove only current server membership from SCCM collection
  ansible.windows.win_powershell:
    parameters:
      SiteCode: "{{ sccm_site_code }}"
      CollectionId: "{{ sccm_collection_id }}"
      ServerName: "{{ inventory_hostname.split('.')[0] }}"
    script: |
      param(
          [string]$SiteCode,
          [string]$CollectionId,
          [string]$ServerName
      )

      $ErrorActionPreference = 'Stop'
      $Ansible.Changed = $false

      Import-Module "$env:SMS_ADMIN_UI_PATH\..\ConfigurationManager.psd1"
      Set-Location "${SiteCode}:\"

      $devices = @(
          Get-CMDevice -Name $ServerName |
              Where-Object { $_.Name -eq $ServerName }
      )

      if ($devices.Count -ne 1) {
          throw "Expected one SCCM device for '$ServerName'; found $($devices.Count)."
      }

      $resourceId = $devices[0].ResourceID

      $membership = @(
          Get-CMDeviceCollectionDirectMembershipRule `
              -CollectionId $CollectionId |
              Where-Object { $_.ResourceID -eq $resourceId }
      )

      if ($membership.Count -gt 0) {
          Remove-CMDeviceCollectionDirectMembershipRule `
              -CollectionId $CollectionId `
              -ResourceId $resourceId `
              -Force

          $Ansible.Changed = $true
          Write-Output "Removed '$ServerName' from collection '$CollectionId'."
      }
      else {
          Write-Output "No direct membership exists for '$ServerName'."
      }
  delegate_to: "{{ groups['sccm'][0] }}"
  throttle: 1
