# 1. Check StartTime, Deadline, and OfferType on the KB5131090 WMI object
Get-CimInstance -Namespace root\ccm\ClientSDK -ClassName CCM_SoftwareUpdate |
  Where-Object ArticleID -eq '5131090' |
  Select-Object ArticleID, Name, ComplianceState, EvaluationState, StartTime, Deadline, @{n='NowLocal';e={Get-Date}}

# 2. Check the exact line in UpdatesDeployment.log for KB5131090
Select-String -Path 'C:\Windows\CCM\Logs\UpdatesDeployment.log' -Pattern '43ad9cad-0c25-4d8b-ab46-5c4d802fe581|5131090' |
  Select-Object -Last 10
