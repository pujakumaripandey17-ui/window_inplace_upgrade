# Confirm latest boot time
Get-CimInstance Win32_OperatingSystem |
    Select-Object CSName, LastBootUpTime

# Exact pending package details
Get-WindowsPackage -Online `
    -PackageName 'Package_for_RollupFix~31bf3856ad364e35~amd64~~20348.5870.1.20' |
    Format-List *

# Recent servicing errors
Get-Content 'C:\Windows\Logs\CBS\CBS.log' -Tail 5000 |
    Select-String `
        -Pattern '5870|0x800f|failed|rollback|reboot' |
    Select-Object -Last 80
