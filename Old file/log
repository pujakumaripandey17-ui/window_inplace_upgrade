try {
    $updates = @(Get-CimInstance `
        -Namespace 'root\ccm\ClientSDK' `
        -ClassName 'CCM_SoftwareUpdate' `
        -ErrorAction Stop)

    Write-Host "SCCM Query SUCCESS"
    Write-Host "Updates returned: $($updates.Count)"
}
catch {
    Write-Host "SCCM Query FAILED"
    Write-Host $_.Exception.Message
}
