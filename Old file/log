---
# Single-file upgrade launch and reconnecting monitor. Setup launch is never retried.
- name: Create status directory
  ansible.windows.win_file:
    path: "{{ upgrade_staging_directory }}\\Status"
    state: directory
  when: not (upgrade_execute_monitor_only | default(false) | bool)

- name: Remove stale status files
  ansible.windows.win_file:
    path: "{{ item }}"
    state: absent
  loop:
    - "{{ upgrade_staging_directory }}\\Status\\setup-returned.json"
    - "{{ upgrade_staging_directory }}\\Status\\upgrade-started.json"
    - "{{ upgrade_staging_directory }}\\Status\\launch-failed.json"
    - "{{ upgrade_staging_directory }}\\Status\\setup-command.json"
  when: not (upgrade_execute_monitor_only | default(false) | bool)

- name: Install guarded upgrade launcher
  ansible.windows.win_template:
    src: start-upgrade.ps1.j2
    dest: "{{ upgrade_staging_directory }}\\start-upgrade.ps1"
  when: not (upgrade_execute_monitor_only | default(false) | bool)

- name: Register and start one-time SYSTEM upgrade task
  ansible.windows.win_powershell:
    parameters:
      ScriptPath: "{{ upgrade_staging_directory }}\\start-upgrade.ps1"
      TaskName: "Ansible-Windows-Server-2022-Upgrade"
    script: |
      param(
        [string]$ScriptPath,
        [string]$TaskName
      )

      $ErrorActionPreference = 'Stop'

      Unregister-ScheduledTask `
        -TaskName $TaskName `
        -Confirm:$false `
        -ErrorAction SilentlyContinue

      $action = New-ScheduledTaskAction `
        -Execute 'PowerShell.exe' `
        -Argument "-NoProfile -ExecutionPolicy Bypass -File `"$ScriptPath`""

      $principal = New-ScheduledTaskPrincipal `
        -UserId 'SYSTEM' `
        -LogonType ServiceAccount `
        -RunLevel Highest

      $settings = New-ScheduledTaskSettingsSet `
        -StartWhenAvailable `
        -ExecutionTimeLimit (New-TimeSpan -Hours 8)

      Register-ScheduledTask `
        -TaskName $TaskName `
        -Action $action `
        -Principal $principal `
        -Settings $settings `
        -Force | Out-Null

      Start-ScheduledTask -TaskName $TaskName

      $Ansible.Result = @{
        task_name = $TaskName
        started   = $true
      }
  when: not (upgrade_execute_monitor_only | default(false) | bool)

- name: Initialize bounded upgrade completion monitoring
  ansible.builtin.set_fact:
    final_upgrade_success: false
    upgrade_monitor_done: false
    upgrade_monitor_terminal_failure: false
    upgrade_monitor_reason: 'Waiting for launch evidence and Windows Server 2022.'
    upgrade_monitor_stable_count: 0
    upgrade_monitor_last_boot: ''
    upgrade_monitor_result: {}
    upgrade_monitor_deadline: "{{ (lookup('ansible.builtin.pipe', 'date +%s') | int) + (upgrade_completion_timeout | default(14400) | int) }}"
  when: not (upgrade_execute_monitor_only | default(false) | bool)

- name: Recover connection and inspect upgrade completion without relaunching Setup
  ansible.builtin.include_tasks:
    file: main.yml
    apply:
      vars:
        upgrade_execute_monitor_only: true
  loop: "{{ range(1, 481) | list }}"
  loop_control:
    loop_var: upgrade_monitor_attempt
    label: "Upgrade monitoring attempt {{ upgrade_monitor_attempt }}"
  when:
    - not (upgrade_execute_monitor_only | default(false) | bool)
    - not upgrade_monitor_done | bool
    - not upgrade_monitor_terminal_failure | bool
    - (lookup('ansible.builtin.pipe', 'date +%s') | int) < (upgrade_monitor_deadline | int)

- name: Require Windows Server 2022 and completed Setup before continuing
  ansible.builtin.assert:
    that:
      - upgrade_monitor_done | bool
      - not upgrade_monitor_terminal_failure | bool
    fail_msg: >-
      Windows upgrade completion was not verified. Last reason={{ upgrade_monitor_reason }}.
      Last observation={{ upgrade_monitor_result }}.
      Setup was launched once only. Connection loss does not prove Setup failed;
      remote Setup may still be running. Check its state before another full run.
  when: not (upgrade_execute_monitor_only | default(false) | bool)

- name: Publish final upgrade validation result
  ansible.builtin.set_fact:
    final_validation:
      result: "{{ upgrade_monitor_result }}"
    final_upgrade_success: "{{ upgrade_monitor_done | bool }}"
  when: not (upgrade_execute_monitor_only | default(false) | bool)

- name: Display final OS information
  ansible.builtin.debug:
    msg:
      - "Caption       : {{ final_validation.result.caption }}"
      - "Version       : {{ final_validation.result.version }}"
      - "Build         : {{ final_validation.result.build }}"
      - "Setup Running : {{ final_validation.result.setup_running }}"
      - "Success       : {{ final_upgrade_success }}"
  when: not (upgrade_execute_monitor_only | default(false) | bool)


# This guard is applied to child tasks as each queued include executes.
- name: Execute one connection recovery and upgrade observation
  when:
    - upgrade_execute_monitor_only | default(false) | bool
    - not upgrade_monitor_done | default(false) | bool
    - not upgrade_monitor_terminal_failure | default(false) | bool
    - (lookup('ansible.builtin.pipe', 'date +%s') | int) < (upgrade_monitor_deadline | int)
  block:
    - name: Calculate remaining upgrade monitoring budget
      ansible.builtin.set_fact:
        upgrade_monitor_seconds_left: >-
          {{ [1, (upgrade_monitor_deadline | int) -
               (lookup('ansible.builtin.pipe', 'date +%s') | int)] | max }}

    - name: Recover usable WinRM connection for this upgrade observation
      ansible.builtin.wait_for_connection:
        sleep: 10
        connect_timeout: 15
        timeout: "{{ [60, upgrade_monitor_seconds_left | int] | min }}"
      register: upgrade_monitor_connection
      ignore_errors: true
      ignore_unreachable: true

    - name: Record temporary connection loss
      ansible.builtin.set_fact:
        upgrade_monitor_stable_count: 0
        upgrade_monitor_reason: "{{ upgrade_monitor_connection.msg | default('WinRM is not usable yet.') }}"
      when: >-
        (upgrade_monitor_connection.failed | default(false) | bool) or
        (upgrade_monitor_connection.unreachable | default(false) | bool)

    - name: Observe launch markers OS and Windows Setup state
      ansible.windows.win_powershell:
        error_action: stop
        parameters:
          StagingDirectory: "{{ upgrade_staging_directory }}"
        script: |
          param([string]$StagingDirectory)
          $ErrorActionPreference = 'Stop'
          $Ansible.Changed = $false
          $Ansible.Result = @{ ready=$false; terminal_failure=$false; reason='Observation pending.' }
          try {
              $status = Join-Path $StagingDirectory 'Status'
              $launchFailure = Join-Path $status 'launch-failed.json'
              if (Test-Path -LiteralPath $launchFailure) {
                  $failure = Get-Content -LiteralPath $launchFailure -Raw -ErrorAction Stop | ConvertFrom-Json -ErrorAction Stop
                  $Ansible.Result = @{ ready=$false; terminal_failure=$true; reason=('Upgrade launcher failed: ' + [string]$failure.message); launch_failure=$failure }
                  return
              }
              $started = Test-Path -LiteralPath (Join-Path $status 'upgrade-started.json')
              $os = Get-CimInstance Win32_OperatingSystem -ErrorAction Stop
              $processes = @(Get-Process -Name setup,setuphost,setupprep -ErrorAction SilentlyContinue)
              $setupFlags = Get-ItemProperty 'HKLM:\SYSTEM\Setup' -ErrorAction Stop
              $registryBusy = ([int]$setupFlags.SystemSetupInProgress -ne 0) -or ([int]$setupFlags.OOBEInProgress -ne 0)
              $setupRunning = $processes.Count -gt 0 -or $registryBusy
              $is2022 = ([string]$os.BuildNumber -eq '20348') -and ([string]$os.Version -like '10.0.20348*') -and ([int]$os.ProductType -ne 1)
              $boot = $os.LastBootUpTime.ToUniversalTime().ToString('o')
              $resultPath = Join-Path $status 'setup-returned.json'
              $setupResult = $null
              if (Test-Path -LiteralPath $resultPath) {
                  $setupResult = Get-Content -LiteralPath $resultPath -Raw -ErrorAction Stop | ConvertFrom-Json -ErrorAction Stop
                  $code = ([string]$setupResult.exit_code_hex).ToUpperInvariant()
                  if ($code -and $code -notin @('0X00000000','0X00000BC2')) {
                      $Ansible.Result = @{ ready=$false; terminal_failure=$true; reason="Windows Setup returned $code : $($setupResult.interpretation)"; setup_result=$setupResult }
                      return
                  }
              }
              $ready = $started -and $is2022 -and -not $setupRunning
              $Ansible.Result = @{
                  ready=[bool]$ready; success=[bool]$ready; terminal_failure=$false
                  caption=[string]$os.Caption; version=[string]$os.Version; build=[string]$os.BuildNumber
                  is2022=[bool]$is2022; setup_running=[bool]$setupRunning
                  setup_processes=@($processes | ForEach-Object ProcessName)
                  setup_registry_busy=[bool]$registryBusy; launcher_started=[bool]$started
                  boot_time_utc=$boot; setup_result=$setupResult
                  reason="Launch marker=$started; Server2022=$is2022; Setup running=$setupRunning."
              }
          }
          catch { $Ansible.Result = @{ ready=$false; terminal_failure=$false; reason=$_.Exception.Message } }
      register: upgrade_monitor_observation
      ignore_errors: true
      ignore_unreachable: true
      when:
        - not (upgrade_monitor_connection.failed | default(false) | bool)
        - not (upgrade_monitor_connection.unreachable | default(false) | bool)
        - (lookup('ansible.builtin.pipe', 'date +%s') | int) < (upgrade_monitor_deadline | int)

    - name: Retain current observation and failure diagnostics
      ansible.builtin.set_fact:
        upgrade_monitor_result: "{{ upgrade_monitor_observation.result | default({}) }}"
        upgrade_monitor_terminal_failure: "{{ upgrade_monitor_observation.result.terminal_failure | default(false) | bool }}"
        upgrade_monitor_reason: >-
          {{ upgrade_monitor_observation.result.reason |
             default(upgrade_monitor_observation.msg | default(upgrade_monitor_reason), true) }}
      when: not (upgrade_monitor_observation.skipped | default(false) | bool)

    - name: Count stable ready observations from the same boot
      ansible.builtin.set_fact:
        upgrade_monitor_stable_count: >-
          {{ ((upgrade_monitor_stable_count | int) + 1)
             if ((upgrade_monitor_observation.result.ready | default(false) | bool)
                 and not (upgrade_monitor_observation.failed | default(false) | bool)
                 and not (upgrade_monitor_observation.unreachable | default(false) | bool)
                 and (upgrade_monitor_observation.result.boot_time_utc | default('')) == upgrade_monitor_last_boot)
             else (1 if ((upgrade_monitor_observation.result.ready | default(false) | bool)
                         and not (upgrade_monitor_observation.failed | default(false) | bool)
                         and not (upgrade_monitor_observation.unreachable | default(false) | bool)) else 0) }}
        upgrade_monitor_last_boot: "{{ upgrade_monitor_observation.result.boot_time_utc | default('') }}"
      when: not (upgrade_monitor_observation.skipped | default(false) | bool)

    - name: Confirm stable OS and Setup completion
      ansible.builtin.set_fact:
        upgrade_monitor_done: "{{ upgrade_monitor_stable_count | int >= 3 and not (upgrade_monitor_terminal_failure | bool) }}"

    - name: Wait before the next connection recovery and observation
      ansible.builtin.pause:
        seconds: >-
          {{ [30, [0, (upgrade_monitor_deadline | int) -
                (lookup('ansible.builtin.pipe', 'date +%s') | int)] | max] | min }}
      when:
        - not upgrade_monitor_done | bool
        - not upgrade_monitor_terminal_failure | bool
        - upgrade_monitor_attempt | int < 480
        - (lookup('ansible.builtin.pipe', 'date +%s') | int) < (upgrade_monitor_deadline | int)
