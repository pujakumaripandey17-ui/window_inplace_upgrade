- name: Reset WinRM connection after October package reboot
  ansible.builtin.meta: reset_connection
  when: october_install.result.reboot_required | bool

- name: Wait for usable WinRM connection before October KB verification
  ansible.builtin.wait_for_connection:
    delay: 30
    sleep: 15
    connect_timeout: 30
    timeout: 1200

