--- 
vcenter_inventory_dfs_path: '\\dfs01\appl\WindowsEng\VMWare\VCCombined\VCCombined_Latest.xlsx'
vcenter_inventory_target_path: '{{ upgrade_staging_directory }}\Inventory\VCCombined_Latest.xlsx'
 




--- 
# Install as roles/windows_upgrade_vm_discovery/tasks/main.yml
# Retain the existing resolver, including its vInfo reset_dimensions() fix.
# Give concurrent Jenkins jobs separate workspaces: host-specific names prevent
# collisions across targets, but not two jobs for the SAME target/workspace.

- name: Validate VCCombined discovery configuration
  ansible.builtin.assert:
    that:
      - vcenter_inventory_dfs_path | default('') | length > 0
      - vcenter_inventory_target_path | default('') | length > 0
      - upgrade_staging_directory | default('') | length > 0
      - vcenter_inventory_dfs_path != vcenter_inventory_target_path
    fail_msg: Configure distinct DFS source and Windows staging paths.

- name: Set controller workbook paths
  ansible.builtin.set_fact:
    vcenter_inventory_controller_directory: "{{ playbook_dir }}/../reports/vcenter_inventory"
    vcenter_inventory_controller_path: "{{ playbook_dir }}/../reports/vcenter_inventory/VCCombined_Latest-{{ inventory_hostname }}.xlsx"

- name: Inspect DFS workbook and calculate its current fingerprint
  ansible.windows.win_powershell:
    parameters:
      SourcePath: "{{ vcenter_inventory_dfs_path }}"
    script: |
      param([Parameter(Mandatory = $true)][string]$SourcePath)
      $ErrorActionPreference = 'Stop'
      $timer = [System.Diagnostics.Stopwatch]::StartNew()
      if (-not (Test-Path -LiteralPath $SourcePath -PathType Leaf)) {
          throw "VCCombined workbook is not accessible: $SourcePath"
      }
      $before = Get-Item -LiteralPath $SourcePath
      $size = $before.Length
      $modified = $before.LastWriteTimeUtc.Ticks
      $hash = (Get-FileHash -LiteralPath $SourcePath -Algorithm SHA256).Hash
      $after = Get-Item -LiteralPath $SourcePath
      if ($size -ne $after.Length -or $modified -ne $after.LastWriteTimeUtc.Ticks) {
          throw 'DFS workbook changed during fingerprinting. Retry discovery.'
      }
      $timer.Stop()
      $Ansible.Result = @{
          source_path = $after.FullName
          source_size = $size
          source_last_write_utc = $after.LastWriteTimeUtc.ToString('o')
          source_sha256 = $hash.ToLowerInvariant()
          fingerprint_seconds = [math]::Round($timer.Elapsed.TotalSeconds, 2)
      }
      $Ansible.Changed = $false
  register: vcenter_inventory_source

- name: Validate source fingerprint
  ansible.builtin.assert:
    that:
      - vcenter_inventory_source.result.source_size | int > 0
      - vcenter_inventory_source.result.source_sha256 is match('^[a-f0-9]{64}$')
    fail_msg: The DFS workbook fingerprint is invalid.

- name: Ensure controller inventory directory exists
  ansible.builtin.file:
    path: "{{ vcenter_inventory_controller_directory }}"
    state: directory
    mode: "0750"
  delegate_to: localhost
  become: false

- name: Inspect existing controller workbook
  ansible.builtin.stat:
    path: "{{ vcenter_inventory_controller_path }}"
    checksum_algorithm: sha256
    get_checksum: true
    get_mime: false
    get_attributes: false
  delegate_to: localhost
  become: false
  register: vcenter_inventory_cached_stat

- name: Determine whether a workbook transfer is required
  ansible.builtin.set_fact:
    vcenter_inventory_transfer_required: >-
      {{ (vcenter_inventory_force_refresh | default(false) | bool)
         or not (vcenter_inventory_cached_stat.stat.isreg | default(false))
         or (vcenter_inventory_cached_stat.stat.checksum | default('') !=
             vcenter_inventory_source.result.source_sha256)
         or (vcenter_inventory_cached_stat.stat.size | default(0) | int !=
             vcenter_inventory_source.result.source_size | int) }}

- name: Stage and fetch only when the controller workbook differs
  when: vcenter_inventory_transfer_required | bool
  block:
    - name: Stage current DFS workbook and verify its SHA-256
      ansible.windows.win_powershell:
        parameters:
          SourcePath: "{{ vcenter_inventory_dfs_path }}"
          DestinationPath: "{{ vcenter_inventory_target_path }}"
          ExpectedHash: "{{ vcenter_inventory_source.result.source_sha256 }}"
          ExpectedSize: "{{ vcenter_inventory_source.result.source_size }}"
        script: |
          param(
              [Parameter(Mandatory = $true)][string]$SourcePath,
              [Parameter(Mandatory = $true)][string]$DestinationPath,
              [Parameter(Mandatory = $true)][string]$ExpectedHash,
              [Parameter(Mandatory = $true)][long]$ExpectedSize
          )
          $ErrorActionPreference = 'Stop'
          $timer = [System.Diagnostics.Stopwatch]::StartNew()
          $directory = Split-Path -Path $DestinationPath -Parent
          if (-not (Test-Path -LiteralPath $directory -PathType Container)) {
              New-Item -Path $directory -ItemType Directory -Force | Out-Null
          }
          # Do not delete the staging file. Overwrite it only on a cache miss.
          Copy-Item -LiteralPath $SourcePath -Destination $DestinationPath -Force
          $destination = Get-Item -LiteralPath $DestinationPath
          $hash = (Get-FileHash -LiteralPath $DestinationPath -Algorithm SHA256).Hash
          if ($destination.Length -ne $ExpectedSize -or $hash -ne $ExpectedHash) {
              throw 'Staged workbook differs from the DFS fingerprint. Retry discovery.'
          }
          $timer.Stop()
          $Ansible.Result = @{
              destination_path = $destination.FullName
              destination_size = $destination.Length
              destination_sha256 = $hash.ToLowerInvariant()
              copy_verify_seconds = [math]::Round($timer.Elapsed.TotalSeconds, 2)
          }
          $Ansible.Changed = $true
      register: vcenter_inventory_copy

    - name: Record workbook fetch start time
      ansible.builtin.set_fact:
        vcenter_inventory_fetch_started: "{{ now(utc=true, fmt='%Y-%m-%dT%H:%M:%S') }}"

    - name: Fetch verified VCCombined workbook to Ansible Controller
      ansible.builtin.fetch:
        src: "{{ vcenter_inventory_target_path }}"
        dest: "{{ vcenter_inventory_controller_path }}"
        flat: true
        # Explicit SHA-256 validation below replaces post-fetch validation.
        # This option does not remove all remote checksum/transport overhead.
        validate_checksum: false
      register: vcenter_inventory_fetch

    - name: Record workbook fetch duration
      ansible.builtin.set_fact:
        vcenter_inventory_fetch_seconds: >-
          {{ ((now(utc=true, fmt='%Y-%m-%dT%H:%M:%S') | to_datetime('%Y-%m-%dT%H:%M:%S'))
              - (vcenter_inventory_fetch_started | to_datetime('%Y-%m-%dT%H:%M:%S'))).total_seconds() }}

- name: Calculate final controller workbook SHA-256
  ansible.builtin.stat:
    path: "{{ vcenter_inventory_controller_path }}"
    checksum_algorithm: sha256
    get_checksum: true
    get_mime: false
    get_attributes: false
  delegate_to: localhost
  become: false
  register: vcenter_inventory_controller_stat

- name: Validate controller workbook against the DFS fingerprint
  ansible.builtin.assert:
    that:
      - vcenter_inventory_controller_stat.stat.isreg | default(false)
      - vcenter_inventory_controller_stat.stat.size | default(0) | int == vcenter_inventory_source.result.source_size | int
      - vcenter_inventory_controller_stat.stat.checksum | default('') == vcenter_inventory_source.result.source_sha256
    fail_msg: Controller workbook failed SHA-256 validation. Discovery will stop.

- name: Display workbook transfer diagnostics
  ansible.builtin.debug:
    msg:
      - "Workbook size MiB: {{ (vcenter_inventory_source.result.source_size | float / 1048576) | round(2) }}"
      - "Controller cache reused: {{ not (vcenter_inventory_transfer_required | bool) }}"
      - "DFS fingerprint seconds: {{ vcenter_inventory_source.result.fingerprint_seconds }}"
      - "Windows copy/verification seconds: {{ vcenter_inventory_copy.result.copy_verify_seconds if (vcenter_inventory_transfer_required | bool) else 0 }}"
      - "Fetch task seconds: {{ vcenter_inventory_fetch_seconds if (vcenter_inventory_transfer_required | bool) else 0 }}"

- name: Verify VM resolver script exists
  ansible.builtin.stat:
    path: "{{ role_path }}/files/resolve_vcenter_vm.py"
    get_checksum: false
    get_mime: false
    get_attributes: false
  delegate_to: localhost
  become: false
  register: vcenter_resolver_script

- name: Stop when VM resolver script is missing
  ansible.builtin.assert:
    that:
      - vcenter_resolver_script.stat.exists
      - vcenter_resolver_script.stat.isreg | default(false)
    fail_msg: "Missing resolver script: {{ role_path }}/files/resolve_vcenter_vm.py"

- name: Resolve target VM from VCCombined workbook
  ansible.builtin.command:
    argv:
      - "{{ ansible_playbook_python }}"
      - "{{ role_path }}/files/resolve_vcenter_vm.py"
      - --file
      - "{{ vcenter_inventory_controller_path }}"
      - --target
      - "{{ inventory_hostname }}"
  delegate_to: localhost
  become: false
  register: vcenter_inventory_lookup
  changed_when: false

- name: Convert VM discovery output to facts
  ansible.builtin.set_fact:
    vcenter_inventory_record: "{{ vcenter_inventory_lookup.stdout | from_json }}"

- name: Set dynamic vCenter facts
  ansible.builtin.set_fact:
    vcenter_hostname: "{{ vcenter_inventory_record.vcenter_hostname }}"
    vcenter_datacenter: "{{ vcenter_inventory_record.vcenter_datacenter }}"
    vcenter_vm_folder: "{{ vcenter_inventory_record.vcenter_vm_folder }}"
    vcenter_vm_name: "{{ vcenter_inventory_record.vm_name }}"
    vcenter_vm_moid: "{{ vcenter_inventory_record.vcenter_vm_moid }}"
    vcenter_vm_uuid: "{{ vcenter_inventory_record.vcenter_vm_uuid | default('') }}"

- name: Validate dynamically discovered vCenter facts
  ansible.builtin.assert:
    that:
      - vcenter_hostname | length > 0
      - vcenter_datacenter | length > 0
      - vcenter_vm_folder | length > 0
      - vcenter_vm_name | length > 0
      - vcenter_vm_moid is match('^vm-[0-9]+$')
    fail_msg: "Incomplete VCCombined record for {{ inventory_hostname }}. Snapshot creation will not continue."

- name: Save non-secret vCenter discovery report
  ansible.builtin.copy:
    content: >-
      {{ vcenter_inventory_record | combine({
           'workbook_sha256': vcenter_inventory_controller_stat.stat.checksum,
           'workbook_source': vcenter_inventory_source.result.source_path,
           'workbook_size': vcenter_inventory_source.result.source_size,
           'workbook_source_last_write_utc': vcenter_inventory_source.result.source_last_write_utc,
           'workbook_cache_reused': not (vcenter_inventory_transfer_required | bool),
           'discovered_at_utc': now(utc=true, fmt='%Y-%m-%dT%H:%M:%SZ')
         }) | to_nice_json }}
    dest: "{{ playbook_dir }}/../reports/{{ inventory_hostname }}-vcenter-discovery.json"
    mode: "0640"
  delegate_to: localhost
  become: false

- name: Display resolved vCenter target
  ansible.builtin.debug:
    msg:
      - "Target inventory host: {{ inventory_hostname }}"
      - "Resolved VM: {{ vcenter_vm_name }}"
      - "vCenter: {{ vcenter_hostname }}"
      - "Datacenter: {{ vcenter_datacenter }}"
      - "Folder: {{ vcenter_vm_folder }}"
      - "VM MoID: {{ vcenter_vm_moid }}"
      - "VM UUID: {{ vcenter_vm_uuid | default('not available') }}"
      - "Workbook SHA-256: {{ vcenter_inventory_controller_stat.stat.checksum }}"
 
