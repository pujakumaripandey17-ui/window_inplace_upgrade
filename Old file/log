---
- name: Validate approved ISO hash
  ansible.builtin.assert:
    that:
      - upgrade_iso_sha256 | length == 64
      - upgrade_iso_sha256 is match('^[A-Fa-f0-9]{64}$')
    fail_msg: "Configure a valid SHA256 checksum."

- name: Create upgrade staging directory
  ansible.windows.win_file:
    path: "{{ upgrade_staging_directory }}"
    state: directory

- name: Verify DFS ISO is accessible
  ansible.windows.win_powershell:
    parameters:
      SourcePath: "{{ upgrade_iso_dfs_path }}"
    script: |
      param([string]$SourcePath)

      $item = Get-Item -LiteralPath $SourcePath -ErrorAction SilentlyContinue

      $Ansible.Result = @{
        accessible = ($null -ne $item)
        size_bytes = if ($item) { $item.Length } else { 0 }
        path       = $SourcePath
      }
  register: dfs_iso

- name: Ensure DFS ISO is available
  ansible.builtin.assert:
    that:
      - dfs_iso.result.accessible | bool
      - dfs_iso.result.size_bytes | int >= upgrade_iso_minimum_size_bytes | int
    fail_msg: "Cannot access ISO from DFS."

- name: Check existing ISO
  ansible.windows.win_stat:
    path: "{{ upgrade_iso_path }}"
    get_checksum: true
    checksum_algorithm: sha256
  register: local_iso

- name: Copy ISO from DFS using robocopy
  ansible.windows.win_powershell:
    parameters:
      SourcePath: "{{ upgrade_iso_dfs_path }}"
      DestinationPath: "{{ upgrade_iso_path }}"
    script: |
      param(
        [string]$SourcePath,
        [string]$DestinationPath
      )

      $ErrorActionPreference = 'Stop'

      $srcDir  = Split-Path $SourcePath -Parent
      $srcFile = Split-Path $SourcePath -Leaf

      $dstDir  = Split-Path $DestinationPath -Parent
      $dstFile = Split-Path $DestinationPath -Leaf

      New-Item -ItemType Directory -Path $dstDir -Force | Out-Null

      robocopy $srcDir $dstDir $srcFile /Z /J /R:3 /W:10 /COPY:DAT /NP /NFL /NDL

      $exitCode = $LASTEXITCODE

      if ($exitCode -ge 8) {
        throw "Robocopy failed with exit code $exitCode"
      }

      $copiedFile = Join-Path $dstDir $srcFile

      if ($srcFile -ne $dstFile) {
        Move-Item $copiedFile $DestinationPath -Force
      }

      $Ansible.Result = @{
        ExitCode   = $exitCode
        Source     = $SourcePath
        Destination = $DestinationPath
      }
  when: >
    not local_iso.stat.exists or
    local_iso.stat.checksum | default('') | lower != upgrade_iso_sha256 | lower

- name: Verify copied ISO
  ansible.windows.win_stat:
    path: "{{ upgrade_iso_path }}"
    get_checksum: true
    checksum_algorithm: sha256
  register: staged_iso

- name: Validate ISO checksum
  ansible.builtin.assert:
    that:
      - staged_iso.stat.exists
      - staged_iso.stat.size | int >= upgrade_iso_minimum_size_bytes | int
      - staged_iso.stat.checksum | lower == upgrade_iso_sha256 | lower
    fail_msg: "ISO checksum validation failed."
    success_msg: "ISO checksum validation passed."

- name: Display ISO details
  ansible.windows.win_powershell:
    parameters:
      IsoPath: "{{ upgrade_iso_path }}"
    script: |
      param([string]$IsoPath)

      $item = Get-Item $IsoPath

      $Ansible.Result = @{
        Name   = $item.Name
        Path   = $item.FullName
        SizeGB = [math]::Round($item.Length / 1GB,2)
        SHA256 = (Get-FileHash $IsoPath -Algorithm SHA256).Hash
      }
  register: iso_details

- name: Show ISO details
  ansible.builtin.debug:
    var: iso_details.result

- name: Validate ISO content
  ansible.windows.win_powershell:
    parameters:
      IsoPath: "{{ upgrade_iso_path }}"
    script: |
      param([string]$IsoPath)

      $mounted = $false

      try {

        $disk = Get-DiskImage -ImagePath $IsoPath

        if (-not $disk.Attached) {
          Mount-DiskImage -ImagePath $IsoPath
          $mounted = $true
        }

        $volume = Get-DiskImage -ImagePath $IsoPath |
                  Get-Volume |
                  Select-Object -First 1

        $drive = $volume.DriveLetter

        $installWim = "$($drive):\sources\install.wim"

        if (-not (Test-Path $installWim)) {
          $installWim = "$($drive):\sources\install.esd"
        }

        $images = Get-WindowsImage -ImagePath $installWim

        $Ansible.Result = @{
          DriveLetter = $drive
          Images = @(
            $images | Select-Object ImageIndex, ImageName
          )
        }
      }
      finally {
        if ($mounted) {
          Dismount-DiskImage -ImagePath $IsoPath
        }
      }
  register: iso_images

- name: Show ISO images
  ansible.builtin.debug:
    var: iso_images.result

- name: Ensure ISO contains Windows Server 2022
  ansible.builtin.assert:
    that:
      - >
        iso_images.result.Images |
        selectattr('ImageName','search','Windows Server 2022') |
        list |
        length > 0
    fail_msg: >
      The mounted ISO is not Windows Server 2022 media.
