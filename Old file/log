- name: Display effective VM discovery configuration
  ansible.builtin.debug:
    msg:
      - "Host: {{ inventory_hostname }}"
      - "Role: {{ role_path }}"
      - "DFS: {{ vcenter_inventory_dfs_path | default('UNDEFINED') }}"
      - "Staging: {{ vcenter_inventory_target_path | default('UNDEFINED') }}"
      - "Working directory: {{ upgrade_staging_directory | default('UNDEFINED') }}"
