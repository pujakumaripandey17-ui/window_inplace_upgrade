ow \"CCMSetup failed: exit=$exitCode. Review C:\\Windows\\CCMSetup\\Logs\\ccmsetup.log\"\n    }\n\n    # CCMSetup may delegate work. Do not reboot while another setup process runs.\n    $deadline = (Get-Date).AddSeconds($TimeoutSeconds)\n    while (Get-Process ccmsetup -ErrorAction SilentlyContinue) {\n        if ((Get-Date) -ge $deadline) {\n            throw 'CCMSetup is still running after the bounded completion wait. Review ccmsetup.log; no reboot or automatic reinstall was attempted.'\n        }\n        Start-Sleep -Seconds 15\n    }\n    Write-Output 'CCMSetup process completion confirmed. Client health will be verified after reboot.'\n}\nfinally {\n    if ($null -eq $previousZoneCheck) {\n        Remove-Item env:SEE_MASK_NOZONECHECKS -ErrorAction SilentlyContinue\n    }\n    else { $env:SEE_MASK_NOZONECHECKS = $previousZoneCheck }\n}", "delta": "0:02:27.924565", "end": "2026-11-17 08:07:13.744459", "rc": 0, "start": "2026-11-17 08:04:45.819893", "stderr": "", "stderr_lines": [], "stdout": "CCMSETUP ExitCode=0\r\nCCMSetup process completion confirmed. Client health will be verified after reboot.\r\n", "stdout_lines": ["CCMSETUP ExitCode=0", "CCMSetup process completion confirmed. Client health will be verified after reboot."]}

