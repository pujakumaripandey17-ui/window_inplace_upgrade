# Actual full OS build
Get-ItemProperty `
  'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion' |
  Select-Object ProductName, CurrentBuildNumber, UBR

# Selected November KB evidence
Get-HotFix -Id KB5131090 |
  Format-List HotFixID, Description, InstalledOn

# OS cumulative package servicing state
Get-WindowsPackage -Online |
  Where-Object PackageName -Like '*RollupFix*' |
  Select-Object PackageName, PackageState, InstallTime |
  Format-List
