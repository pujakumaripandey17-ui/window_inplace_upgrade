$estZone = [System.TimeZoneInfo]::FindSystemTimeZoneById('Eastern Standard Time')
           $start   = [System.TimeZoneInfo]::ConvertTimeFromUtc((Get-Date).ToUniversalTime(), $estZone).AddMinutes(-5)
           $end     = $start.AddHours(12)

$mwName = (
   "Post-upgrade patching - " +
   $TargetComputer +
   " - " +
   $start.ToString('yyyyMMdd-HHmmss')
)

$schedule = New-CMSchedule `
   -Start $start `
   -End $end `
   -Nonrecurring


$updates = @(
           Get-CimInstance `
               -Namespace root\ccm\ClientSDK `
               -ClassName CCM_SoftwareUpdate `
               -ErrorAction Stop |
           Where-Object { ($_.ComplianceState -ne 1 -and $_.EvaluationState -ne 0) -or $_.ErrorCode -ne 0 -or $_.EvaluationState -eq 13 }
       )
