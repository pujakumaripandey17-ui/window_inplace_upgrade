$destination = 'C:\Windows\Temp\SCCM-Servicing-Diagnostics.zip'

$logs = @(
    Get-ChildItem 'C:\Windows\Logs\CBS' -File |
        Where-Object {
            $_.Name -eq 'CBS.log' -or
            $_.Name -like 'CbsPersist*'
        } |
        Sort-Object LastWriteTime -Descending |
        Select-Object -First 5
)

$logs += Get-Item 'C:\Windows\Logs\DISM\dism.log' `
    -ErrorAction SilentlyContinue

Compress-Archive `
    -LiteralPath @($logs.FullName) `
    -DestinationPath $destination `
    -Force

$destination
