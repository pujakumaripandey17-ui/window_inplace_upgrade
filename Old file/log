Get-Service TrustedInstaller, wuauserv |
    Select-Object Name, Status, StartType

[pscustomobject]@{
    CBSRebootPending = Test-Path `
      'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Component Based Servicing\RebootPending'

    CBSPackagesPending = Test-Path `
      'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Component Based Servicing\PackagesPending'

    PendingXml = Test-Path 'C:\Windows\WinSxS\pending.xml'
}

Get-ChildItem 'C:\Windows\Logs\CBS' -File |
    Sort-Object LastWriteTime -Descending |
    Select-Object -First 6 Name, LastWriteTime, Length
