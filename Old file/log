$start = (Get-Date).ToUniversalTime().AddMinutes(-5)
              $end   = $start.AddHours(12)

              $mwName = (
                  "Post-upgrade patching - " +
                  $TargetComputer +
                  " - " +
                  $start.ToString('yyyyMMdd-HHmmss')
              )

              $schedule = New-CMSchedule `
                  -Start $start `
                  -End $end `
                  -Nonrecurring `
                  -IsUtc
