Get-ScheduledTask |
    Where-Object TaskName -in @(
        'Ansible-Windows-2022-Upgrade'
        'Ansible-Windows-Server-2022-Upgrade'
    ) |
    Select-Object TaskName, State

Get-Process setup,setuphost,setupprep -ErrorAction SilentlyContinue |
    Select-Object ProcessName, Id

Get-ItemProperty 'HKLM:\SYSTEM\Setup' |
    Select-Object SystemSetupInProgress, OOBEInProgress

Get-Content 'C:\WindowsUpgrade\Status\upgrade-started.json' -Raw
