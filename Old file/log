- name: Verify October KB is installed before continuing
  ansible.windows.win_powershell:
    error_action: stop
    parameters:
      Source: "{{ october_source }}"
    script: |
      param([string]$Source)

      $ErrorActionPreference = 'Stop'
      $Ansible.Changed = $false
      $Ansible.Result = @{
          ready  = $false
          reason = 'Verification has not completed.'
      }

      try {
          $verification = (
              & 'C:\Scripts\October2022.ps1' `
                  -Action Validate `
                  -Source $Source |
              ConvertFrom-Json -ErrorAction Stop
          )

          if ($verification.status -ne 'VerifiedInstalled') {
              throw "Unexpected validation result: $(
                  $verification | ConvertTo-Json -Compress
              )"
          }

          $Ansible.Result = @{
              ready        = $true
              reason       = 'October KB installation verified.'
              verification = $verification
          }
      }
      catch {
          $Ansible.Result = @{
              ready  = $false
              reason = $_.Exception.Message
          }
      }
  register: october_verification
  until: october_verification.result.ready | default(false) | bool
  retries: 45
  delay: 20
