$ErrorActionPreference = 'Stop'

$tasks = @(
    Get-ScheduledTask |
        Where-Object TaskName -in @(
            'Ansible-Windows-2022-Upgrade'
            'Ansible-Windows-Server-2022-Upgrade'
        )
)

$processes = @(
    Get-Process setup,setuphost,setupprep -ErrorAction SilentlyContinue
)

$setup = Get-ItemProperty 'HKLM:\SYSTEM\Setup'

if (
    @($tasks | Where-Object { $_.State -in @('Running', 'Queued') }).Count -gt 0 -or
    $processes.Count -gt 0 -or
    $null -eq $setup.SystemSetupInProgress -or
    $null -eq $setup.OOBEInProgress -or
    $setup.SystemSetupInProgress -ne 0 -or
    $setup.OOBEInProgress -ne 0
) {
    throw 'Setup activity exists or its state is uncertain. Markers were not moved.'
}

$status = 'C:\WindowsUpgrade\Status'
$archive = Join-Path $status (
    'Archive-' + (Get-Date -Format 'yyyyMMdd-HHmmss') +
    '-' + [guid]::NewGuid().ToString('N').Substring(0,8)
)

New-Item -ItemType Directory -Path $archive | Out-Null

foreach ($name in @(
    'upgrade-started.json'
    'setup-returned.json'
    'launch-failed.json'
    'setup-command.json'
)) {
    $path = Join-Path $status $name
    if (Test-Path -LiteralPath $path) {
        Move-Item -LiteralPath $path -Destination $archive
    }
}

Write-Host "Previous markers archived: $archive"
