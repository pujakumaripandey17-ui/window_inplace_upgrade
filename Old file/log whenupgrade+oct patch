
---
# ============================================================
# WINDOWS SERVER 2016 -> 2022 UPGRADE EXECUTION
# ============================================================

- name: Initialize upgrade monitoring variables
  ansible.builtin.set_fact:
    upgrade_complete: false
    upgrade_failed: false
    upgrade_reason: "Waiting for Windows Server 2022"
    monitor_attempt: 0
    monitor_max_attempts: 180
    final_upgrade_success: false

# ============================================================
# CHECK CURRENT OPERATING SYSTEM
# ============================================================

- name: Check current Windows operating system
  ansible.windows.win_powershell:
    error_action: stop
    script: |
      $ErrorActionPreference = 'Stop'
      $Ansible.Changed = $false

      $os = Get-CimInstance Win32_OperatingSystem

      $Ansible.Result = @{
        caption = [string]$os.Caption
        build = [string]$os.BuildNumber
        is2022 = (
          $os.BuildNumber -eq '20348' -and
          $os.ProductType -ne 1
        )
      }
  register: initial_os
  changed_when: false

- name: Display current OS
  ansible.builtin.debug:
    msg:
      - "OS: {{ initial_os.result.caption }}"
      - "Build: {{ initial_os.result.build }}"

- name: Mark already upgraded server
  ansible.builtin.set_fact:
    upgrade_complete: true
    upgrade_reason: "Windows Server 2022 already installed"
  when: initial_os.result.is2022 | bool

# ============================================================
# START UPGRADE ONLY WHEN REQUIRED
# ============================================================

- name: Start Windows Server upgrade
  when: not (upgrade_complete | bool)
  block:

    - name: Create upgrade status directory
      ansible.windows.win_file:
        path: "{{ upgrade_staging_directory }}\\Status"
        state: directory

    - name: Remove previous status files
      ansible.windows.win_file:
        path: "{{ item }}"
        state: absent
      loop:
        - "{{ upgrade_staging_directory }}\\Status\\launch-failed.json"
        - "{{ upgrade_staging_directory }}\\Status\\setup-returned.json"
        - "{{ upgrade_staging_directory }}\\Status\\upgrade-started.json"

    - name: Install upgrade launcher script
      ansible.windows.win_template:
        src: start-upgrade.ps1.j2
        dest: "{{ upgrade_staging_directory }}\\start-upgrade.ps1"

    - name: Register and start SYSTEM upgrade task
      ansible.windows.win_powershell:
        error_action: stop
        parameters:
          ScriptPath: "{{ upgrade_staging_directory }}\\start-upgrade.ps1"
          TaskName: "Ansible-Windows-2022-Upgrade"
        script: |
          param(
            [string]$ScriptPath,
            [string]$TaskName
          )

          $ErrorActionPreference = 'Stop'

          $existing = Get-ScheduledTask `
            -TaskName $TaskName `
            -ErrorAction SilentlyContinue

          if ($existing) {
            $taskInfo = Get-ScheduledTaskInfo `
              -TaskName $TaskName

            if ($taskInfo.State -eq 'Running') {
              throw "Upgrade task is already running"
            }

            Unregister-ScheduledTask `
              -TaskName $TaskName `
              -Confirm:$false
          }

          $action = New-ScheduledTaskAction `
            -Execute 'PowerShell.exe' `
            -Argument "-NoProfile -ExecutionPolicy Bypass -File `"$ScriptPath`""

          $principal = New-ScheduledTaskPrincipal `
            -UserId 'SYSTEM' `
            -LogonType ServiceAccount `
            -RunLevel Highest

          $settings = New-ScheduledTaskSettingsSet `
            -StartWhenAvailable `
            -ExecutionTimeLimit (New-TimeSpan -Hours 8)

          Register-ScheduledTask `
            -TaskName $TaskName `
            -Action $action `
            -Principal $principal `
            -Settings $settings `
            -Force | Out-Null

          Start-ScheduledTask -TaskName $TaskName

          $Ansible.Result = @{
            started = $true
            task_name = $TaskName
          }

    - name: Reset WinRM connection before monitoring
      ansible.builtin.meta: reset_connection

    # IMPORTANT:
    # The monitor file controls its own iterations.
    # Do not add loop/range here.

    - name: Monitor Windows upgrade
      ansible.builtin.include_tasks:
        file: monitor_upgrade.yml

# ============================================================
# CONFIRM MONITORING COMPLETED
# ============================================================

- name: Confirm Windows Server 2022 detected
  ansible.builtin.assert:
    that:
      - upgrade_complete | bool
      - not (upgrade_failed | bool)
    fail_msg: "{{ upgrade_reason }}"
    success_msg: "Windows Server 2022 detected"

# ============================================================
# WAIT FOR WINDOWS SETUP PROCESSES
# ============================================================

- name: Wait until Windows Setup processes exit
  ansible.windows.win_powershell:
    error_action: stop
    parameters:
      StagingDirectory: "{{ upgrade_staging_directory }}"
    script: |
      param([string]$StagingDirectory)

      $Ansible.Changed = $false

      $setup = @(
        Get-Process -Name setup,setuphost,setupprep `
          -ErrorAction SilentlyContinue
      )

      $result = @{
        completed = ($setup.Count -eq 0)
        terminal_failure = $false
        reason = "Waiting for Windows Setup processes"
      }

      $failurePath = Join-Path `
        $StagingDirectory 'Status\launch-failed.json'

      $returnedPath = Join-Path `
        $StagingDirectory 'Status\setup-returned.json'

      if (Test-Path -LiteralPath $failurePath) {
        $result.terminal_failure = $true
        $result.reason = "Upgrade launcher failure marker found"
      }

      if (Test-Path -LiteralPath $returnedPath) {
        try {
          $returned = Get-Content $returnedPath -Raw |
            ConvertFrom-Json

          $exitHex = (
            [string]$returned.exit_code_hex
          ).ToUpperInvariant()

          if (
            $exitHex -and
            $exitHex -notin @('0X00000000','0X00000BC2')
          ) {
            $result.terminal_failure = $true
            $result.reason = "Windows Setup failure: $exitHex"
          }
        }
        catch {
          $result.terminal_failure = $true
          $result.reason = "Invalid Setup status file: $_"
        }
      }

      $Ansible.Result = $result
  register: setup_status
  until: >-
    (setup_status.result.completed | default(false) | bool)
    or
    (setup_status.result.terminal_failure | default(false) | bool)
  retries: 240
  delay: 15
  changed_when: false

- name: Confirm Setup process monitoring passed
  ansible.builtin.assert:
    that:
      - setup_status.result.completed | bool
      - not (setup_status.result.terminal_failure | bool)
    fail_msg: "{{ setup_status.result.reason }}"

# ============================================================
# RESTORE AND VALIDATE WINRM CONNECTION
# ============================================================

- name: Reset WinRM connection after upgrade
  ansible.builtin.meta: reset_connection

- name: Wait for WinRM connection
  ansible.builtin.wait_for_connection:
    delay: 15
    sleep: 15
    timeout: 3600

- name: Verify PowerShell execution through WinRM
  ansible.windows.win_powershell:
    error_action: stop
    script: |
      $Ansible.Changed = $false

      $Ansible.Result = @{
        winrm_ready = $true
        hostname = $env:COMPUTERNAME
      }
  register: winrm_validation
  changed_when: false

- name: Confirm WinRM is operational
  ansible.builtin.assert:
    that:
      - winrm_validation.result.winrm_ready | bool
    fail_msg: "WinRM is not ready after Windows upgrade"

# ============================================================
# FINAL WINDOWS SERVER 2022 VALIDATION
# ============================================================

- name: Validate final Windows Server version
  ansible.windows.win_powershell:
    error_action: stop
    script: |
      $ErrorActionPreference = 'Stop'
      $Ansible.Changed = $false

      $os = Get-CimInstance Win32_OperatingSystem

      $setup = @(
        Get-Process -Name setup,setuphost,setupprep `
          -ErrorAction SilentlyContinue
      )

      $Ansible.Result = @{
        caption = [string]$os.Caption
        build = [string]$os.BuildNumber
        setup_running = ($setup.Count -gt 0)
        success = (
          $os.BuildNumber -eq '20348' -and
          $os.ProductType -ne 1 -and
          $setup.Count -eq 0
        )
      }
  register: final_validation
  changed_when: false

- name: Confirm final upgrade success
  ansible.builtin.assert:
    that:
      - final_validation.result.success | bool
    fail_msg: >-
      Windows Server 2022 final validation failed.
      Build: {{ final_validation.result.build }}
      Setup running: {{ final_validation.result.setup_running }}

- name: Save final upgrade result
  ansible.builtin.set_fact:
    final_upgrade_success: true

- name: Display successful upgrade completion
  ansible.builtin.debug:
    msg:
      - "Windows Server 2022 upgrade execution completed"
      - "OS: {{ final_validation.result.caption }}"
      - "Build: {{ final_validation.result.build }}"
      - "WinRM: Ready"
      - "Final upgrade success: {{ final_upgrade_success }}"
      - "Returning to next task in 03_upgrade.yml"
